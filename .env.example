# Copy to .env and fill in. NEVER commit .env.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MAX_UPLOAD_MB=20
MAX_QUESTION_CHARS=1000
MIN_EXTRACTED_CHARS=50
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LLM provider: Ollama (local) or Gemini (Google AI Studio)
LLM_PROVIDER=ollama
# Ollama must be running at http://localhost:11434. If LLM_MODEL is blank,
# Ollama uses llama3.2:3b. For Gemini, set a current model and API key below.
# Set a CURRENT Gemini model name that your key can use (see https://ai.google.dev/gemini-api/docs/models).
# Names change and older ones are retired, so none is hard-coded. Google's deprecations page
# (https://ai.google.dev/gemini-api/docs/deprecations) lists gemini-2.5-flash as scheduled for
# retirement with gemini-3.5-flash as its recommended replacement. NOT VERIFIED with a real key
# by the project author: confirm the model works for you (python scripts/verify_real.py --gemini).
LLM_MODEL=
# Gemini only: create a key in AI Studio ("Get API key"). Never commit it.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Retries for transient Gemini errors (503/429/408/5xx/network): waits ~1s, 2s, 4s. 0 disables.
LLM_MAX_RETRIES=3
